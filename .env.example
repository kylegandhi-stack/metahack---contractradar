# Copy to .env.local (never commit .env.local). Server-side only: never prefix with NEXT_PUBLIC_.
MODEL_API_KEY=
# Optional. Only if the SAM.gov key test passes by Tue 10:30 AM PT.
SAM_API_KEY=
# Optional. Runs allowed per IP per window, and per day per server instance. 0 turns a limit off.
# RATE_LIMIT_PER_IP=5
# RATE_LIMIT_WINDOW_MINUTES=10
# RATE_LIMIT_DAILY=50
# RATE_LIMIT_VOICE_DAILY=50
# Set to "on" to fetch SAM.gov description text for the shortlist: up to 5 extra SAM.gov calls per run.
# SAM_DESCRIPTIONS=on
